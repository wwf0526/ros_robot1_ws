        <joint name="sec2_u1_bend_y" type="hinge" axis="0 1 0" range="-0.6 0.6"/>
        <joint name="sec2_u1_slide_z" type="slide" axis="0 0 1" range="-0.03 0.03"/>
        <geom name="sec2_u1_disk" type="mesh" mesh="hex_disk" rgba="0.2 0.5 0.9 1"/>
