<mujoco model="continuum_kinematic">
  <compiler angle="radian"/>

  <option timestep="0.01" gravity="0 0 0"/>

  <default>
    <joint limited="true" damping="0" armature="0"/>
    <geom contype="0" conaffinity="0" density="1000"/>
  </default>

  <asset>
    <mesh name="hex_disk" file="assets/hex_disk.stl"/>
